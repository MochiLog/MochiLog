    "mt_102": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog checks paired computers periodically. A previous response does not mean they are continuously connected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携中のPCとの通信は定期的に確認します。応答履歴があっても、常時接続を意味するものではありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog prüft gekoppelte Computer regelmäßig. Eine frühere Antwort bedeutet keine dauerhafte Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog comprueba periódicamente los ordenadores enlazados. Una respuesta anterior no significa conexión permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog vérifie régulièrement les ordinateurs jumelés. Une réponse passée ne signifie pas une connexion permanente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog는 페어링된 PC를 주기적으로 확인합니다. 이전 응답이 계속 연결되어 있음을 뜻하지는 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog 会定期检查已配对的电脑。之前收到响应不代表持续连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog 會定期檢查已配對的電腦。先前收到回應不代表持續連線。"
          }
        }
      }
    },
