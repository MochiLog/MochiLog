          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog 컴퓨터 페어링용 QR 코드가 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 MochiLog 电脑配对二维码。"
          }
        },
