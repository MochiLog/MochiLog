    "live_state_stale": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Previous values · refresh failed"}},"ja":{"stringUnit":{"state":"translated","value":"以前の値・更新失敗"}},"de":{"stringUnit":{"state":"translated","value":"Frühere Werte · Aktualisierung fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"Valores anteriores · actualización fallida"}},"fr":{"stringUnit":{"state":"translated","value":"Valeurs précédentes · échec d’actualisation"}},"ko":{"stringUnit":{"state":"translated","value":"이전 값 · 업데이트 실패"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先前的值 · 更新失败"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先前的值 · 更新失敗"}}}},
    "live_state_waiting": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for acquisition"}},"ja":{"stringUnit":{"state":"translated","value":"取得を待っています"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf Erfassung"}},"es":{"stringUnit":{"state":"translated","value":"Esperando datos"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de données"}},"ko":{"stringUnit":{"state":"translated","value":"수집 대기 중"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待获取"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"等待取得"}}}},
    "live_state_unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Acquisition unavailable"}},"ja":{"stringUnit":{"state":"translated","value":"取得できません"}},"de":{"stringUnit":{"state":"translated","value":"Erfassung nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"Datos no disponibles"}},"fr":{"stringUnit":{"state":"translated","value":"Acquisition indisponible"}},"ko":{"stringUnit":{"state":"translated","value":"수집할 수 없음"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法获取"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法取得"}}}},
    "live_state_network": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for an allowed network"}},"ja":{"stringUnit":{"state":"translated","value":"通信が許可された回線を待っています"}},"de":{"stringUnit":{"state":"translated","value":"Warten auf erlaubtes Netzwerk"}},"es":{"stringUnit":{"state":"translated","value":"Esperando una red permitida"}},"fr":{"stringUnit":{"state":"translated","value":"En attente d’un réseau autorisé"}},"ko":{"stringUnit":{"state":"translated","value":"허용된 네트워크 대기 중"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待允许的网络"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"等待允許的網路"}}}},
    "live_state_offline": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"PC unavailable · previous values may be shown"}},"ja":{"stringUnit":{"state":"translated","value":"PCに接続できません・以前の値が表示される場合があります"}},"de":{"stringUnit":{"state":"translated","value":"PC nicht erreichbar · frühere Werte möglich"}},"es":{"stringUnit":{"state":"translated","value":"PC no disponible · pueden mostrarse valores anteriores"}},"fr":{"stringUnit":{"state":"translated","value":"PC indisponible · valeurs précédentes possibles"}},"ko":{"stringUnit":{"state":"translated","value":"PC 연결 불가 · 이전 값이 표시될 수 있음"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑无法连接 · 可能显示先前的值"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"電腦無法連線 · 可能顯示先前的值"}}}},
    "live_state_update": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Update the PC app to use Live Battery"}},"ja":{"stringUnit":{"state":"translated","value":"現在値を表示するにはPCアプリを更新してください"}},"de":{"stringUnit":{"state":"translated","value":"PC-App für aktuelle Akkuwerte aktualisieren"}},"es":{"stringUnit":{"state":"translated","value":"Actualiza la app del PC para ver la batería actual"}},"fr":{"stringUnit":{"state":"translated","value":"Mettez à jour l’app PC pour afficher la batterie actuelle"}},"ko":{"stringUnit":{"state":"translated","value":"현재 값을 보려면 PC 앱을 업데이트하세요"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请更新电脑应用以查看当前电池信息"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請更新電腦應用程式以查看目前電池資訊"}}}},
    "mt_legacy_update": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This computer uses an older transfer protocol. Update its companion app to restore protected transfer."}}, "ja": {"stringUnit": {"state": "translated", "value": "このPCは旧方式で通信しています。PCアプリを更新すると保護された転送に戻ります。"}}, "de": {"stringUnit": {"state": "translated", "value": "Dieser Computer verwendet ein älteres Übertragungsprotokoll. Aktualisieren Sie die Begleit-App."}}, "es": {"stringUnit": {"state": "translated", "value": "Este ordenador usa un protocolo de transferencia anterior. Actualiza la app complementaria."}}, "fr": {"stringUnit": {"state": "translated", "value": "Cet ordinateur utilise un ancien protocole de transfert. Mettez à jour son app."}}, "ko": {"stringUnit": {"state": "translated", "value": "이 컴퓨터는 이전 전송 방식을 사용합니다. 컴퓨터 앱을 업데이트하세요."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这台电脑使用旧版传输协议。请更新电脑应用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "這部電腦使用舊版傳輸協定。請更新電腦 App。"}}}},
    "mt_legacy_update_link": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Update the computer app on GitHub"}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHubでPCアプリを更新"}}, "de": {"stringUnit": {"state": "translated", "value": "Computer-App auf GitHub aktualisieren"}}, "es": {"stringUnit": {"state": "translated", "value": "Actualizar la app en GitHub"}}, "fr": {"stringUnit": {"state": "translated", "value": "Mettre à jour l’app sur GitHub"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub에서 컴퓨터 앱 업데이트"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在 GitHub 更新电脑应用"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在 GitHub 更新電腦 App"}}}},
    "mt_unpair_button": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remove MochiLog pairing"}}, "ja": {"stringUnit": {"state": "translated", "value": "MochiLogの連携を解除"}}, "de": {"stringUnit": {"state": "translated", "value": "MochiLog-Kopplung entfernen"}}, "es": {"stringUnit": {"state": "translated", "value": "Desvincular MochiLog"}}, "fr": {"stringUnit": {"state": "translated", "value": "Dissocier MochiLog"}}, "ko": {"stringUnit": {"state": "translated", "value": "MochiLog 페어링 해제"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "解除 MochiLog 配对"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "解除 MochiLog 配對"}}}},
    "mt_unpair_title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remove this pairing?"}}, "ja": {"stringUnit": {"state": "translated", "value": "この連携を解除しますか？"}}, "de": {"stringUnit": {"state": "translated", "value": "Diese Kopplung entfernen?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Desvincular este dispositivo?"}}, "fr": {"stringUnit": {"state": "translated", "value": "Dissocier cet appareil ?"}}, "ko": {"stringUnit": {"state": "translated", "value": "이 페어링을 해제할까요?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "解除此配对？"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "解除此配對？"}}}},
    "mt_unpair_detail": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This device stops exchanging logs immediately. The other side will remove this pairing when it next connects. Saved battery records and the computer's OS trust are kept."}}, "ja": {"stringUnit": {"state": "translated", "value": "この端末とのログ転送はすぐに停止します。相手側は次に接続したとき連携を解除します。保存済みの記録とOSの信頼設定は残ります。"}}, "de": {"stringUnit": {"state": "translated", "value": "Die Logübertragung stoppt sofort. Die Gegenseite entfernt die Kopplung bei der nächsten Verbindung. Gespeicherte Einträge und das OS-Vertrauen bleiben erhalten."}}, "es": {"stringUnit": {"state": "translated", "value": "La transferencia de registros se detiene ahora. El otro lado se desvinculará al volver a conectarse. Se conservan los registros y la confianza del sistema."}}, "fr": {"stringUnit": {"state": "translated", "value": "Le transfert des journaux s'arrête immédiatement. L'autre appareil se dissociera à sa prochaine connexion. Les données et la confiance du système sont conservées."}}, "ko": {"stringUnit": {"state": "translated", "value": "로그 전송이 즉시 중지됩니다. 상대 기기는 다음 연결 시 페어링을 해제합니다. 저장된 기록과 OS 신뢰 설정은 유지됩니다."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "日志传输会立即停止。另一端下次连接时将解除配对。已保存的记录和系统信任设置会保留。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "日誌傳輸會立即停止。另一端下次連線時將解除配對。已儲存的記錄與系統信任設定會保留。"}}}},
    "mt_unpair_pending": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pairing removed here. Waiting to notify the other device when it reconnects."}}, "ja": {"stringUnit": {"state": "translated", "value": "こちらの連携は解除済みです。相手端末への通知は再接続時に行います。"}}, "de": {"stringUnit": {"state": "translated", "value": "Hier entfernt. Die Gegenseite wird bei der nächsten Verbindung benachrichtigt."}}, "es": {"stringUnit": {"state": "translated", "value": "Desvinculado aquí. Se notificará al otro dispositivo cuando vuelva a conectarse."}}, "fr": {"stringUnit": {"state": "translated", "value": "Dissocié ici. L'autre appareil sera informé à sa prochaine connexion."}}, "ko": {"stringUnit": {"state": "translated", "value": "이쪽의 페어링은 해제되었습니다. 상대 기기에 다시 연결되면 알립니다."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此处已解除配对。重新连接时会通知另一端。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此處已解除配對。重新連線時會通知另一端。"}}}},
    "mt_manual_ip_title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Computer IP address"}}, "ja": {"stringUnit": {"state": "translated", "value": "パソコンのIPアドレス"}}, "de": {"stringUnit": {"state": "translated", "value": "IP-Adresse des Computers"}}, "es": {"stringUnit": {"state": "translated", "value": "Dirección IP del ordenador"}}, "fr": {"stringUnit": {"state": "translated", "value": "Adresse IP de l’ordinateur"}}, "ko": {"stringUnit": {"state": "translated", "value": "컴퓨터 IP 주소"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "电脑 IP 地址"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "電腦 IP 位址"}}}},
    "mt_manual_ip_placeholder": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "IPv4 address, such as 192.168.1.20"}}, "ja": {"stringUnit": {"state": "translated", "value": "IPv4アドレス（例：192.168.1.20）"}}, "de": {"stringUnit": {"state": "translated", "value": "IPv4-Adresse, z. B. 192.168.1.20"}}, "es": {"stringUnit": {"state": "translated", "value": "Dirección IPv4, p. ej. 192.168.1.20"}}, "fr": {"stringUnit": {"state": "translated", "value": "Adresse IPv4, p. ex. 192.168.1.20"}}, "ko": {"stringUnit": {"state": "translated", "value": "IPv4 주소 (예: 192.168.1.20)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "IPv4 地址，例如 192.168.1.20"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "IPv4 位址，例如 192.168.1.20"}}}},
    "mt_manual_ip_save": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save IP"}}, "ja": {"stringUnit": {"state": "translated", "value": "IPを保存"}}, "de": {"stringUnit": {"state": "translated", "value": "IP speichern"}}, "es": {"stringUnit": {"state": "translated", "value": "Guardar IP"}}, "fr": {"stringUnit": {"state": "translated", "value": "Enregistrer IP"}}, "ko": {"stringUnit": {"state": "translated", "value": "IP 저장"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "保存 IP"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "儲存 IP"}}}},
    "mt_manual_ip_clear": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use automatic IP"}}, "ja": {"stringUnit": {"state": "translated", "value": "自動IPに戻す"}}, "de": {"stringUnit": {"state": "translated", "value": "Automatische IP"}}, "es": {"stringUnit": {"state": "translated", "value": "Usar IP automática"}}, "fr": {"stringUnit": {"state": "translated", "value": "Utiliser IP automatique"}}, "ko": {"stringUnit": {"state": "translated", "value": "자동 IP 사용"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用自动 IP"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用自動 IP"}}}},
    "mt_manual_ip_footer": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Optional. Specify the Mac or Windows PC’s IPv4 address if automatic discovery fails. The saved address is tried first; clear it after the IP changes."}}, "ja": {"stringUnit": {"state": "translated", "value": "任意。Mac・Windowsの自動検索に失敗した場合にIPv4アドレスを指定します。保存したIPを優先します。変更後は入力し直すか自動IPに戻してください。"}}, "de": {"stringUnit": {"state": "translated", "value": "Optional. Geben Sie die IPv4-Adresse des Mac oder Windows-PCs an, wenn die automatische Suche fehlschlägt. Die gespeicherte Adresse wird zuerst versucht."}}, "es": {"stringUnit": {"state": "translated", "value": "Opcional. Indica la dirección IPv4 del Mac o PC Windows si falla la detección automática. Se probará primero la dirección guardada."}}, "fr": {"stringUnit": {"state": "translated", "value": "Facultatif. Indiquez l’adresse IPv4 du Mac ou PC Windows si la découverte automatique échoue. L’adresse enregistrée est essayée en premier."}}, "ko": {"stringUnit": {"state": "translated", "value": "선택 사항. 자동 검색에 실패하면 Mac 또는 Windows PC의 IPv4 주소를 입력하세요. 저장된 주소를 먼저 사용합니다."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "可选。如果自动发现失败，请填写 Mac 或 Windows 电脑的 IPv4 地址。会优先尝试保存的地址。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選填。如果自動搜尋失敗，請填寫 Mac 或 Windows 電腦的 IPv4 位址。會優先嘗試儲存的位址。"}}}},
