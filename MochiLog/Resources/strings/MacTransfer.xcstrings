    "mt_help_missing_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily analytics log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日次の解析ログがない"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein tägliches Analyseprotokoll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el registro diario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun journal quotidien"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 분석 로그가 없을 때"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有每日分析日志"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有每日分析日誌"
          }
        }
      }
    },
    "mt_help_missing_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check analytics sharing in Settings → Privacy & Security → Analytics & Improvements, especially after a system update. A newly enabled device may need until the next daily log."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定 → プライバシーとセキュリティ → 解析と改善」で解析の共有を確認してください。OS更新後も再確認を。オンにした直後は次の日次ログまで待つ必要があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Analysefreigabe unter Einstellungen → Datenschutz & Sicherheit → Analyse & Verbesserungen, besonders nach einem Systemupdate. Nach dem Aktivieren kann es bis zum nächsten Tagesprotokoll dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el uso compartido de análisis en Ajustes → Privacidad y seguridad → Análisis y mejoras, sobre todo tras actualizar el sistema. Si lo acabas de activar, espera al siguiente registro diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le partage des analyses dans Réglages → Confidentialité et sécurité → Analyse et améliorations, surtout après une mise à jour. Après l’activation, attendez le prochain journal quotidien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특히 시스템 업데이트 후 설정 → 개인정보 보호 및 보안 → 분석 및 향상에서 분석 공유를 다시 확인하세요. 방금 켰다면 다음 일일 로그까지 기다려야 할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置 → 隐私与安全性 → 分析与改进”中检查分析共享，尤其是在系统更新后。刚开启时可能要等到下一份每日日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定 → 隱私權與安全性 → 分析與改進」中檢查分析共享，尤其是在系統更新後。剛啟用時可能要等到下一份每日日誌。"
          }
        }
      }
    },
    "mt_help_collect_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac cannot collect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで収集できない"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac kann nicht sammeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac no puede recopilar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac ne peut pas recueillir"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 수집할 수 없을 때"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 无法收集"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 無法收集"
          }
        }
      }
    },
    "mt_help_collect_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the device unlocked, the Mac awake, and both on the same Wi-Fi. Confirm OS pairing in Devices, then try Collect Now. Collection retries every five minutes while the app is running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のロックを解除し、Macをスリープさせず、同じWi-Fiに接続してください。「端末」でOSペアリングを確認し、「今すぐログを収集」を試してください。アプリの動作中は5分ごとに再試行します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre das Gerät, halte den Mac wach und verbinde beide mit demselben WLAN. Prüfe die Systemkopplung unter Geräte und starte „Jetzt sammeln“. Bei laufender App erfolgt alle fünf Minuten ein neuer Versuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el dispositivo, mantén el Mac activo y usa la misma red Wi-Fi. Comprueba el enlace del sistema en Dispositivos y pulsa «Recopilar ahora». La app reintenta cada cinco minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez l’appareil, gardez le Mac éveillé et utilisez le même Wi-Fi. Vérifiez le jumelage système dans Appareils, puis lancez la collecte. L’app réessaie toutes les cinq minutes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 잠금을 해제하고 Mac이 잠자기 상태가 아니며 같은 Wi-Fi에 연결되어 있는지 확인하세요. 기기 화면에서 시스템 페어링을 확인한 뒤 지금 수집을 누르세요. 앱 실행 중에는 5분마다 다시 시도합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁设备、保持 Mac 唤醒，并连接同一 Wi-Fi。在“设备”中确认系统配对后，点按“立即收集”。App 运行时每五分钟重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖裝置、保持 Mac 喚醒，並連接同一 Wi-Fi。在「裝置」中確認系統配對後，點按「立即收集」。App 執行時每五分鐘重試。"
          }
        }
      }
    },
    "mt_help_import_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collected, but no new record"
          }
        },
        "ja": {
          "stringUnit": {
