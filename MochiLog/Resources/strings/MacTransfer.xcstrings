    "mt_manual_ip_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Specify the Mac or Windows PC’s IPv4 address if automatic discovery fails. The saved address is tried first; clear it after the IP changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。Mac・Windowsの自動検索に失敗した場合にIPv4アドレスを指定します。保存したIPを優先します。変更後は入力し直すか自動IPに戻してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Geben Sie die IPv4-Adresse des Mac oder Windows-PCs an, wenn die automatische Suche fehlschlägt. Die gespeicherte Adresse wird zuerst versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Indica la dirección IPv4 del Mac o PC Windows si falla la detección automática. Se probará primero la dirección guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Indiquez l’adresse IPv4 du Mac ou PC Windows si la découverte automatique échoue. L’adresse enregistrée est essayée en premier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 자동 검색에 실패하면 Mac 또는 Windows PC의 IPv4 주소를 입력하세요. 저장된 주소를 먼저 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。如果自动发现失败，请填写 Mac 或 Windows 电脑的 IPv4 地址。会优先尝试保存的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。如果自動搜尋失敗，請填寫 Mac 或 Windows 電腦的 IPv4 位址。會優先嘗試儲存的位址。"
          }
        }
      }
    },
