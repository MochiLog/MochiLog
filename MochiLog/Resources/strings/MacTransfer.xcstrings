    "mt_win_step_1": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Install MochiLog Windows. The release includes the collector and runtimes; no separate Python or .NET setup is needed." } },
        "ja": { "stringUnit": { "state": "translated", "value": "MochiLog Windowsをインストールします。収集ツールと実行環境は同梱され、Pythonや.NETの別途導入は不要です。" } },
        "de": { "stringUnit": { "state": "translated", "value": "Installiere MochiLog Windows. Sammler und Laufzeit sind enthalten; Python oder .NET müssen nicht separat installiert werden." } },
        "es": { "stringUnit": { "state": "translated", "value": "Instala MochiLog Windows. Incluye el recolector y los componentes necesarios; no hace falta instalar Python ni .NET." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Installez MochiLog Windows. Le collecteur et les composants nécessaires sont inclus ; Python et .NET ne sont pas à installer séparément." } },
        "ko": { "stringUnit": { "state": "translated", "value": "MochiLog Windows를 설치합니다. 수집 도구와 실행 환경이 포함되어 있어 Python이나 .NET을 별도로 설치할 필요가 없습니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "安装 MochiLog Windows。收集工具和运行环境均已内置，无需另装 Python 或 .NET。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "安裝 MochiLog Windows。收集工具與執行環境均已內建，無須另裝 Python 或 .NET。" } }
      }
    },
    "mt_win_step_2": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Unlock this device and connect it to the PC once by USB. Approve Trust, finish OS pairing in MochiLog Windows, then disconnect the cable and verify Wi-Fi. Apple Devices and classic iTunes are handled without switching between them." } },
        "ja": { "stringUnit": { "state": "translated", "value": "端末をロック解除して一度だけUSB接続し、「信頼」を許可します。WindowsアプリでOSペアリングを終え、ケーブルを外してWi-Fi接続を確認します。Apple Devicesと従来のiTunesのどちらを使っていても、入れ替えは不要です。" } },
        "de": { "stringUnit": { "state": "translated", "value": "Entsperre das Gerät und verbinde es einmal per USB. Bestätige „Vertrauen“, schließe die Kopplung in MochiLog Windows ab und prüfe nach dem Abziehen die WLAN-Verbindung. Apple Devices und klassisches iTunes müssen nicht gewechselt werden." } },
        "es": { "stringUnit": { "state": "translated", "value": "Desbloquea el dispositivo y conéctalo una vez por USB. Acepta Confiar, completa el enlace en MochiLog Windows y comprueba el Wi-Fi tras desconectar el cable. No es necesario cambiar entre Apple Devices e iTunes clásico." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Déverrouillez l’appareil et connectez-le une fois en USB. Autorisez la confiance, terminez l’association dans MochiLog Windows, puis vérifiez le Wi-Fi après avoir retiré le câble. Aucun changement entre Apple Devices et iTunes classique n’est requis." } },
        "ko": { "stringUnit": { "state": "translated", "value": "기기 잠금을 해제하고 USB로 한 번 연결합니다. 신뢰를 승인하고 MochiLog Windows에서 OS 페어링을 마친 뒤 케이블을 빼고 Wi-Fi 연결을 확인합니다. Apple Devices와 기존 iTunes를 교체할 필요는 없습니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "解锁设备并通过 USB 连接一次。允许“信任”，在 MochiLog Windows 中完成系统配对，拔线后验证 Wi-Fi。无需在 Apple Devices 与旧版 iTunes 之间切换。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "解鎖裝置並透過 USB 連接一次。允許「信任」，在 MochiLog Windows 中完成系統配對，拔線後驗證 Wi-Fi。無須在 Apple Devices 與舊版 iTunes 之間切換。" } }
      }
    },
    "mt_win_step_3": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Select this device in MochiLog Windows. Scan its QR code here and enter the six-digit code shown on the PC. Other paired computers remain registered." } },
        "ja": { "stringUnit": { "state": "translated", "value": "MochiLog Windowsでこの端末を選びます。PCに表示されるQRコードをここで読み取り、6桁のコードを入力します。ほかの登録済みPCも残ります。" } },
        "de": { "stringUnit": { "state": "translated", "value": "Wähle dieses Gerät in MochiLog Windows. Scanne hier den QR-Code und gib den sechsstelligen Code vom PC ein. Andere gekoppelte Computer bleiben erhalten." } },
        "es": { "stringUnit": { "state": "translated", "value": "Selecciona este dispositivo en MochiLog Windows. Escanea aquí el QR e introduce el código de seis dígitos del PC. Se conservan los otros ordenadores enlazados." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Sélectionnez cet appareil dans MochiLog Windows. Scannez son QR ici et saisissez le code à six chiffres affiché sur le PC. Les autres ordinateurs associés restent enregistrés." } },
        "ko": { "stringUnit": { "state": "translated", "value": "MochiLog Windows에서 이 기기를 선택합니다. 여기에서 QR 코드를 읽고 PC에 표시된 6자리 코드를 입력합니다. 다른 페어링된 컴퓨터는 유지됩니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在 MochiLog Windows 中选择本设备。在这里扫描二维码，并输入电脑显示的六位代码。其他已配对电脑仍会保留。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在 MochiLog Windows 中選擇本裝置。在此掃描 QR 碼，並輸入電腦顯示的六位數代碼。其他已配對電腦仍會保留。" } }
      }
    },
    "mt_win_step_4": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Leave MochiLog Windows running to collect logs while the device is unlocked. Open MochiLog here to receive, analyze and store them." } },
        "ja": { "stringUnit": { "state": "translated", "value": "端末のロック解除中に収集できるようMochiLog Windowsを起動しておきます。このMochiLogを開くとログを受信・解析・記録します。" } },
        "de": { "stringUnit": { "state": "translated", "value": "Lass MochiLog Windows geöffnet, um bei entsperrtem Gerät Logs zu sammeln. Öffne MochiLog hier zum Empfangen, Analysieren und Speichern." } },
        "es": { "stringUnit": { "state": "translated", "value": "Deja MochiLog Windows abierto para recopilar registros mientras el dispositivo esté desbloqueado. Abre MochiLog aquí para recibirlos, analizarlos y guardarlos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Laissez MochiLog Windows ouvert pour collecter les journaux quand l’appareil est déverrouillé. Ouvrez MochiLog ici pour les recevoir, analyser et enregistrer." } },
        "ko": { "stringUnit": { "state": "translated", "value": "기기가 잠금 해제된 동안 로그를 수집하도록 MochiLog Windows를 실행해 둡니다. 여기에서 MochiLog를 열면 로그를 수신·분석·기록합니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "保持 MochiLog Windows 运行，以便在设备解锁时收集日志。在本机打开 MochiLog 后接收、分析并保存。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "保持 MochiLog Windows 執行，以便在裝置解鎖時收集記錄。在本機開啟 MochiLog 後接收、分析並儲存。" } }
      }
    },
    "mt_log_view_latest": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "View latest log"}}, "ja": {"stringUnit": {"state": "translated", "value": "最新のログを表示"}}, "de": {"stringUnit": {"state": "translated", "value": "Neuestes Log anzeigen"}}, "es": {"stringUnit": {"state": "translated", "value": "Ver el último registro"}}, "fr": {"stringUnit": {"state": "translated", "value": "Afficher le dernier journal"}}, "ko": {"stringUnit": {"state": "translated", "value": "최신 로그 보기"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看最新日志"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "檢視最新記錄"}}}},
    "mt_log_days_title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Device debug logs"}}, "ja": {"stringUnit": {"state": "translated", "value": "端末のデバッグログ"}}, "de": {"stringUnit": {"state": "translated", "value": "Geräte-Debug-Logs"}}, "es": {"stringUnit": {"state": "translated", "value": "Registros de depuración del dispositivo"}}, "fr": {"stringUnit": {"state": "translated", "value": "Journaux de débogage de l’appareil"}}, "ko": {"stringUnit": {"state": "translated", "value": "기기 디버그 로그"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "设备调试日志"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "裝置偵錯記錄"}}}},
    "mt_log_remote_title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Latest computer log"}}, "ja": {"stringUnit": {"state": "translated", "value": "PCからの最新ログ"}}, "de": {"stringUnit": {"state": "translated", "value": "Neuestes Computer-Log"}}, "es": {"stringUnit": {"state": "translated", "value": "Último registro del ordenador"}}, "fr": {"stringUnit": {"state": "translated", "value": "Dernier journal de l’ordinateur"}}, "ko": {"stringUnit": {"state": "translated", "value": "컴퓨터의 최신 로그"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "电脑的最新日志"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "電腦的最新記錄"}}}},
    "mt_log_storage_title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Log storage"}}, "ja": {"stringUnit": {"state": "translated", "value": "ログの保存設定"}}, "de": {"stringUnit": {"state": "translated", "value": "Log-Speicherung"}}, "es": {"stringUnit": {"state": "translated", "value": "Almacenamiento de registros"}}, "fr": {"stringUnit": {"state": "translated", "value": "Stockage des journaux"}}, "ko": {"stringUnit": {"state": "translated", "value": "로그 저장 설정"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "日志存储设置"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "記錄儲存設定"}}}},
    "mt_log_days_count": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%d days"}}, "ja": {"stringUnit": {"state": "translated", "value": "%d日間"}}, "de": {"stringUnit": {"state": "translated", "value": "%d Tage"}}, "es": {"stringUnit": {"state": "translated", "value": "%d días"}}, "fr": {"stringUnit": {"state": "translated", "value": "%d jours"}}, "ko": {"stringUnit": {"state": "translated", "value": "%d일"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%d 天"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "%d 天"}}}},
    "mt_log_retention_help": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Keep connection debug logs for this period. Battery records are unaffected."}}, "ja": {"stringUnit": {"state": "translated", "value": "連携の調査用ログを選んだ期間だけ保存します。電池の記録には影響しません。"}}, "de": {"stringUnit": {"state": "translated", "value": "Verbindungs-Debug-Logs werden für diesen Zeitraum gespeichert. Batteriedaten bleiben unverändert."}}, "es": {"stringUnit": {"state": "translated", "value": "Conserva los registros de conexión durante este período. Los datos de batería no cambian."}}, "fr": {"stringUnit": {"state": "translated", "value": "Conservez les journaux de connexion pendant cette durée. Les données de batterie ne sont pas modifiées."}}, "ko": {"stringUnit": {"state": "translated", "value": "연결 디버그 로그를 선택한 기간 동안 보관합니다. 배터리 기록에는 영향이 없습니다."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "连接调试日志将保存所选天数。电池记录不受影响。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連線偵錯記錄將保存所選天數。電池記錄不受影響。"}}}},
    "mt_log_delete_help": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only connection debug logs are deleted. Battery records remain."}}, "ja": {"stringUnit": {"state": "translated", "value": "連携のデバッグログだけを削除します。電池の記録は残ります。"}}, "de": {"stringUnit": {"state": "translated", "value": "Nur Verbindungs-Debug-Logs werden gelöscht. Batteriedaten bleiben erhalten."}}, "es": {"stringUnit": {"state": "translated", "value": "Solo se eliminan los registros de conexión. Los datos de batería permanecen."}}, "fr": {"stringUnit": {"state": "translated", "value": "Seuls les journaux de connexion sont supprimés. Les données de batterie sont conservées."}}, "ko": {"stringUnit": {"state": "translated", "value": "연결 디버그 로그만 삭제합니다. 배터리 기록은 유지됩니다."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅删除连接调试日志，电池记录会保留。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅刪除連線偵錯記錄，電池記錄會保留。"}}}},
    "mt_log_no_days": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No saved dates"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存された日付なし"}}, "de": {"stringUnit": {"state": "translated", "value": "Keine gespeicherten Tage"}}, "es": {"stringUnit": {"state": "translated", "value": "No hay fechas guardadas"}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune date enregistrée"}}, "ko": {"stringUnit": {"state": "translated", "value": "저장된 날짜 없음"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无已保存日期"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "沒有已儲存日期"}}}},
    "mt_log_retention": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Keep logs (days)"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存日数"}}, "de": {"stringUnit": {"state": "translated", "value": "Logs behalten (Tage)"}}, "es": {"stringUnit": {"state": "translated", "value": "Conservar registros (días)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Conserver les journaux (jours)"}}, "ko": {"stringUnit": {"state": "translated", "value": "로그 보관 일수"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "日志保留天数"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "記錄保留天數"}}}},
    "mt_log_delete": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Delete debug logs"}}, "ja": {"stringUnit": {"state": "translated", "value": "デバッグログを削除"}}, "de": {"stringUnit": {"state": "translated", "value": "Debug-Logs löschen"}}, "es": {"stringUnit": {"state": "translated", "value": "Eliminar registros de depuración"}}, "fr": {"stringUnit": {"state": "translated", "value": "Supprimer les journaux de débogage"}}, "ko": {"stringUnit": {"state": "translated", "value": "디버그 로그 삭제"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "删除调试日志"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除偵錯記錄"}}}},
    "mt_log_delete_confirm": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Delete all saved Mac connection debug logs?"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みのMac連携デバッグログをすべて削除しますか？"}}, "de": {"stringUnit": {"state": "translated", "value": "Alle gespeicherten Mac-Verbindungslogs löschen?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Eliminar todos los registros de conexión con Mac?"}}, "fr": {"stringUnit": {"state": "translated", "value": "Supprimer tous les journaux de connexion Mac ?"}}, "ko": {"stringUnit": {"state": "translated", "value": "저장된 Mac 연결 디버그 로그를 모두 삭제할까요?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "删除所有已保存的 Mac 连接调试日志？"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除所有已儲存的 Mac 連線偵錯記錄？"}}}},
    "mt_log_date": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Log date"}}, "ja": {"stringUnit": {"state": "translated", "value": "ログの日付"}}, "de": {"stringUnit": {"state": "translated", "value": "Log-Datum"}}, "es": {"stringUnit": {"state": "translated", "value": "Fecha del registro"}}, "fr": {"stringUnit": {"state": "translated", "value": "Date du journal"}}, "ko": {"stringUnit": {"state": "translated", "value": "로그 날짜"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "日志日期"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "記錄日期"}}}},
    "mt_log_incident": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "When did the issue occur?"}}, "ja": {"stringUnit": {"state": "translated", "value": "問題が発生した日時"}}, "de": {"stringUnit": {"state": "translated", "value": "Wann ist das Problem aufgetreten?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Cuándo ocurrió el problema?"}}, "fr": {"stringUnit": {"state": "translated", "value": "Quand le problème est-il survenu ?"}}, "ko": {"stringUnit": {"state": "translated", "value": "문제 발생 날짜와 시간"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "问题发生时间"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "問題發生時間"}}}},
    "mt_log_support_days": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Debug logs for that day and the preceding two days will be attached."}}, "ja": {"stringUnit": {"state": "translated", "value": "発生日とその前の2日分のデバッグログを添付します。"}}, "de": {"stringUnit": {"state": "translated", "value": "Debug-Logs dieses Tages und der beiden Vortage werden angehängt."}}, "es": {"stringUnit": {"state": "translated", "value": "Se adjuntarán los registros de ese día y los dos anteriores."}}, "fr": {"stringUnit": {"state": "translated", "value": "Les journaux de ce jour et des deux jours précédents seront joints."}}, "ko": {"stringUnit": {"state": "translated", "value": "해당 날짜와 이전 이틀의 디버그 로그를 첨부합니다."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将附上当天及前两天的调试日志。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "將附上當天及前兩天的偵錯記錄。"}}}}
  },
  "version": "1.0"
}
