    "mt_035": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac report and the latest iPhone report received by this Mac are attached. Raw analytics logs and pairing secrets are excluded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの診断情報と、このMacが最後に受け取ったiPhoneの診断情報を添付します。解析ログの本文やペアリングの秘密鍵は含めません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der MAC-Bericht und der neueste iPhone-Bericht, den dieser Mac erhalten hat, sind beigefügt. Rohanalyseprotokolle und Kopplungsgeheimnisse sind ausgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adjuntan el informe de Mac y el último informe de iPhone recibido por este Mac. Se excluyen los registros de análisis sin procesar y los secretos de emparejamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport Mac et le dernier rapport iPhone reçu par ce Mac sont joints. Les journaux d'analyse bruts et les secrets d'appariement sont exclus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 받은 Mac 보고서와 최신 iPhone 보고서가 첨부되어 있습니다. 원시 분석 로그 및 페어링 비밀은 제외됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随函附上此Mac收到的Mac报告和最新的iPhone报告。原始分析日志和配对密钥被排除在外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附上此Mac收到的Mac報告和最新iPhone報告。原始分析日志和配對密鑰被排除在外。"
          }
        }
      }
    },
    "mt_036": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone diagnostics have arrived yet. Open MochiLog on the iPhone and connect to this Mac to include them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの診断情報はまだ届いていません。iPhoneでMochiLogを開いてMacに接続すると添付されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch keine iPhone-Diagnose eingetroffen. Öffnen Sie MochiLog auf dem iPhone und verbinden Sie sich mit diesem Mac, um sie einzubeziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no han llegado los diagnósticos del iPhone. Abre MochiLog en el iPhone y conéctate a este Mac para incluirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun diagnostic iPhone n'est encore arrivé. Ouvrez MochiLog sur l'iPhone et connectez-vous à ce Mac pour les inclure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 iPhone 진단 프로그램이 도착하지 않았습니다. iPhone에서 MochiLog를 열고 이 Mac에 연결하여 포함하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未收到iPhone诊断程序。在iPhone上打开MochiLog并连接到此Mac以包含它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未收到iPhone診斷程式。在iPhone上打開MochiLog ，並連接到此Mac以包含它們。"
          }
        }
      }
    },
