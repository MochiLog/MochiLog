    "mt_043": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection, collection, and transfer events. Raw analytics logs and secrets are excluded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続・収集・転送の状態を表示します。解析ログの本文や秘密鍵は含まれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungs-, Sammel- und Übertragungsereignisse. Rohe Analyseprotokolle und -geheimnisse sind ausgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos de conexión, recolección y transferencia. Se excluyen los registros y secretos de análisis sin procesar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événements de connexion, de collecte et de transfert. Les journaux d'analyse bruts et les secrets sont exclus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결, 수집 및 전송 이벤트. 원시 분석 로그 및 비밀은 제외됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接、收集和传输事件。原始分析日志和机密被排除在外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線、收集和傳輸事件。原始分析日志和祕密被排除在外。"
          }
        }
      }
    },
