    "mt_067": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After reinstalling, pair with the same Mac to recover the same device ID. Records stored only locally cannot be recovered after deleting the app. Older records without IDs are not merged automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再インストール後は同じMacで再ペアリングすると同じ個体IDを受け取れます。iCloud同期がオフの間の記録は、アプリ削除時に復元できません。既存のIDなし記録は自動で結合しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer Neuinstallation erhalten Sie dieselbe Geräte-ID, wenn Sie erneut mit demselben Mac koppeln. Nur lokal gespeicherte Einträge gehen beim Löschen der App verloren. Ältere Einträge ohne ID werden nicht automatisch zusammengeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras reinstalar, empareja con el mismo Mac para recuperar el mismo ID. Los registros solo locales no se recuperan si eliminas la app. Los registros antiguos sin ID no se fusionan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une réinstallation, jumelez avec le même Mac pour récupérer le même identifiant. Les données uniquement locales sont perdues si vous supprimez l’app. Les anciennes données sans identifiant ne sont pas fusionnées automatiquement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설치 후 같은 Mac과 다시 페어링하면 동일한 기기 ID를 복원할 수 있습니다. 로컬에만 저장된 기록은 앱 삭제 시 복구할 수 없습니다. ID가 없는 이전 기록은 자동 병합하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安装后，与同一台 Mac 配对即可恢复相同设备 ID。删除应用后，仅保存在本机的记录无法恢复。无 ID 的旧记录不会自动合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安裝後，與同一部 Mac 配對即可恢復相同裝置 ID。刪除 App 後，僅儲存在本機的紀錄無法還原。沒有 ID 的舊紀錄不會自動合併。"
          }
        }
      }
    },
