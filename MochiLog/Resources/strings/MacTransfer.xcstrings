    "mt_077": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this device's records with its previous ID will receive the Mac's ID. Older records without an ID and other models are unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に付けた以前の個体IDをMacのIDに変更します。IDのない旧記録や他の機種の記録は変更しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Einträge dieses Geräts mit der bisherigen ID erhalten die Mac-ID. Ältere Einträge ohne ID und Einträge anderer Modelle bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los registros de este dispositivo con el ID anterior recibirán el ID del Mac. Los registros antiguos sin ID y los de otros modelos no cambiarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les données de cet appareil portant l’ancien identifiant recevront celui du Mac. Les anciennes données sans identifiant et celles d’autres modèles ne changent pas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 이전 ID가 있는 기록에만 Mac의 ID를 적용합니다. ID가 없는 이전 기록과 다른 모델의 기록은 변경하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此设备中带有旧 ID 的记录会改用 Mac 的 ID。无 ID 的旧记录及其他型号的记录不会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此裝置中帶有舊 ID 的紀錄會改用 Mac 的 ID。沒有 ID 的舊紀錄及其他機型的紀錄不會變更。"
          }
        }
      }
    },
    "mt_078": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac transfer is in beta. A fix may take time, and we may not be able to reply individually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac連携はベータ版です。解決まで時間がかかる場合があり、個別に返信できない場合もあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mac-Übertragung ist eine Betafunktion. Eine Lösung kann Zeit brauchen; möglicherweise können wir nicht individuell antworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia desde Mac está en beta. Una solución puede tardar y quizá no podamos responder individualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert Mac est en bêta. La résolution peut prendre du temps et nous pourrions ne pas répondre individuellement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 전송은 베타 기능입니다. 해결에 시간이 걸리거나 개별 답변을 드리지 못할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 传输仍处于测试阶段。解决问题可能需要时间，也可能无法逐一回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 傳輸仍處於測試階段。解決問題可能需要時間，也可能無法逐一回覆。"
          }
        }
      }
    },
