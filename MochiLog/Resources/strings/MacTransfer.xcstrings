    "mt_019": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR belongs to the selected device. Scan it in MochiLog. The same device ID is restored after reinstalling the iPhone app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRは選択した端末専用です。iPhoneのMochiLogで読み取ってください。再インストール後も同じ個体IDを復元できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR gehört zum ausgewählten Gerät. Scannen Sie es in MochiLog. Die gleiche Geräte-ID wird nach der Neuinstallation der iPhone-App wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este QR pertenece al dispositivo seleccionado. Escanéalo en MochiLog. El mismo ID de dispositivo se restaura después de reinstalar la aplicación para iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR appartient à l'appareil sélectionné. Scannez-le dans MochiLog. Le même identifiant d'appareil est restauré après la réinstallation de l'application iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR은 선택한 장치에 속합니다. MochiLog에서 스캔하세요. iPhone 앱을 다시 설치하면 동일한 장치 ID가 복원됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二维码属于所选设备。在MochiLog中扫描。重新安装iPhone应用程序后，将恢复相同的设备ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此QR碼屬於所選裝置。在MochiLog中掃描。重新安裝iPhone應用程式後，會恢復相同的裝置ID。"
          }
        }
      }
    },
    "mt_020": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR contains a temporary public key. Enter the 6-digit code shown on this Mac to confirm pairing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRには一時的な公開鍵が含まれます。Macに表示された6桁のコードを入力してペアリングを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der QR-Code enthält einen temporären öffentlichen Schlüssel. Gib den 6-stelligen Code auf diesem Mac ein, um die Kopplung zu bestätigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El QR contiene una clave pública temporal. Introduce el código de 6 dígitos del Mac para confirmar el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le QR contient une clé publique temporaire. Saisissez le code à 6 chiffres affiché sur ce Mac pour confirmer le jumelage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드에는 임시 공개 키가 포함됩니다. Mac에 표시된 6자리 코드를 입력해 페어링을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码包含临时公钥。输入这台 Mac 上显示的 6 位代码以确认配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 碼包含暫時公開金鑰。輸入這台 Mac 上顯示的 6 位代碼以確認配對。"
          }
        }
      }
    },
