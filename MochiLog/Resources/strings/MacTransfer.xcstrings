    "mt_086": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up an email account on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末にメールアカウントを設定してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie auf diesem Gerät ein E-Mail-Konto ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura una cuenta de correo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez un compte e-mail sur cet appareil."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 메일 계정을 설정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在此设备上设置电子邮件账户。"
          }
        },
        "zh-Hant": {
