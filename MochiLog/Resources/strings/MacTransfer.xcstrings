        "ja": { "stringUnit": { "state": "translated", "value": "サポートとデバッグログを開く" } },
        "de": { "stringUnit": { "state": "translated", "value": "Support und Debugprotokolle öffnen" } },
        "es": { "stringUnit": { "state": "translated", "value": "Abrir soporte y registros de depuración" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrir l’assistance et les journaux de débogage" } },
        "ko": { "stringUnit": { "state": "translated", "value": "지원 및 디버그 로그 열기" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开支持与调试日志" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟支援與除錯日誌" } }
