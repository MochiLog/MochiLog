    "mt_secure_pair_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enter the code shown beside the QR on your computer. The code itself is never sent over the network." } },
        "ja": { "stringUnit": { "state": "translated", "value": "パソコンのQRの横に表示されたコードを入力してください。コード自体はネットワークに送信されません。" } },
        "de": { "stringUnit": { "state": "translated", "value": "Gib den Code neben dem QR-Code auf deinem Computer ein. Der Code selbst wird nicht über das Netzwerk gesendet." } },
        "es": { "stringUnit": { "state": "translated", "value": "Introduce el código junto al QR del ordenador. El código no se envía por la red." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Saisissez le code affiché à côté du QR sur l’ordinateur. Le code lui-même n’est pas envoyé sur le réseau." } },
        "ko": { "stringUnit": { "state": "translated", "value": "컴퓨터의 QR 코드 옆에 표시된 코드를 입력하세요. 코드 자체는 네트워크로 전송되지 않습니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请输入电脑上二维码旁边显示的代码。代码本身不会通过网络发送。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請輸入電腦上 QR 碼旁顯示的代碼。代碼本身不會透過網路傳送。" } }
      }
    },
