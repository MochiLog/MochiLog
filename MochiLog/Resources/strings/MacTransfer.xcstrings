{
  "sourceLanguage": "en",
  "strings": {
    "mt_legacy_update": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer uses an older transfer protocol. Update its companion app to restore protected transfer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このPCは旧方式で通信しています。PCアプリを更新すると保護された転送に戻ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Computer verwendet ein älteres Übertragungsprotokoll. Aktualisieren Sie die Begleit-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ordenador usa un protocolo de transferencia anterior. Actualiza la app complementaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ordinateur utilise un ancien protocole de transfert. Mettez à jour son app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터는 이전 전송 방식을 사용합니다. 컴퓨터 앱을 업데이트하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑使用旧版传输协议。请更新电脑应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部電腦使用舊版傳輸協定。請更新電腦 App。"
          }
        }
      }
    },
    "mt_legacy_update_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the computer app on GitHub"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubでPCアプリを更新"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer-App auf GitHub aktualisieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar la app en GitHub"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour l’app sur GitHub"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 컴퓨터 앱 업데이트"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 更新电脑应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 更新電腦 App"
          }
        }
      }
    },
    "mt_unpair_button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove MochiLog pairing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLogの連携を解除"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog-Kopplung entfernen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincular MochiLog"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier MochiLog"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog 페어링 해제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解除 MochiLog 配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除 MochiLog 配對"
          }
        }
      }
    },
    "mt_unpair_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this pairing?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連携を解除しますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopplung entfernen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desvincular este dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier cet appareil ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페어링을 해제할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解除此配对？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除此配對？"
          }
        }
      }
    },
    "mt_unpair_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device stops exchanging logs immediately. The other side will remove this pairing when it next connects. Saved battery records and the computer's OS trust are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末とのログ転送はすぐに停止します。相手側は次に接続したとき連携を解除します。保存済みの記録とOSの信頼設定は残ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Logübertragung stoppt sofort. Die Gegenseite entfernt die Kopplung bei der nächsten Verbindung. Gespeicherte Einträge und das OS-Vertrauen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia de registros se detiene ahora. El otro lado se desvinculará al volver a conectarse. Se conservan los registros y la confianza del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert des journaux s'arrête immédiatement. L'autre appareil se dissociera à sa prochaine connexion. Les données et la confiance du système sont conservées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 전송이 즉시 중지됩니다. 상대 기기는 다음 연결 시 페어링을 해제합니다. 저장된 기록과 OS 신뢰 설정은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志传输会立即停止。另一端下次连接时将解除配对。已保存的记录和系统信任设置会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌傳輸會立即停止。另一端下次連線時將解除配對。已儲存的記錄與系統信任設定會保留。"
          }
        }
      }
    },
    "mt_unpair_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing removed here. Waiting to notify the other device when it reconnects."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こちらの連携は解除済みです。相手端末への通知は再接続時に行います。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier entfernt. Die Gegenseite wird bei der nächsten Verbindung benachrichtigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvinculado aquí. Se notificará al otro dispositivo cuando vuelva a conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocié ici. L'autre appareil sera informé à sa prochaine connexion."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이쪽의 페어링은 해제되었습니다. 상대 기기에 다시 연결되면 알립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处已解除配对。重新连接时会通知另一端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處已解除配對。重新連線時會通知另一端。"
          }
        }
      }
    },
