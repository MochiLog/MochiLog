    "live_AtCriticalLevel": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Critically low charge"}},"ja":{"stringUnit":{"state":"translated","value":"残量が危険域"}},"de":{"stringUnit":{"state":"translated","value":"Kritisch niedriger Ladestand"}},"es":{"stringUnit":{"state":"translated","value":"Nivel de carga crítico"}},"fr":{"stringUnit":{"state":"translated","value":"Niveau de charge critique"}},"ko":{"stringUnit":{"state":"translated","value":"위험 수준의 잔량"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电量处于临界水平"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"電量處於臨界水準"}}}},
    "live_BatteryInstalled": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Battery present"}},"ja":{"stringUnit":{"state":"translated","value":"バッテリー搭載"}},"de":{"stringUnit":{"state":"translated","value":"Akku vorhanden"}},"es":{"stringUnit":{"state":"translated","value":"Batería presente"}},"fr":{"stringUnit":{"state":"translated","value":"Batterie présente"}},"ko":{"stringUnit":{"state":"translated","value":"배터리 장착"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装电池"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝電池"}}}},
    "live_AppleRawExternalConnected": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw external power connection"}},"ja":{"stringUnit":{"state":"translated","value":"外部電源に接続（生値）"}},"de":{"stringUnit":{"state":"translated","value":"Externe Stromverbindung (Rohwert)"}},"es":{"stringUnit":{"state":"translated","value":"Conexión de alimentación externa (valor bruto)"}},"fr":{"stringUnit":{"state":"translated","value":"Connexion externe (valeur brute)"}},"ko":{"stringUnit":{"state":"translated","value":"외부 전원 연결 (원시 값)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外部电源连接（原始值）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"外部電源連接（原始值）"}}}},
    "live_ExternalChargeCapable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"External power can charge"}},"ja":{"stringUnit":{"state":"translated","value":"外部電源から充電可能"}},"de":{"stringUnit":{"state":"translated","value":"Laden über externe Stromversorgung möglich"}},"es":{"stringUnit":{"state":"translated","value":"Alimentación externa apta para cargar"}},"fr":{"stringUnit":{"state":"translated","value":"Alimentation externe capable de charger"}},"ko":{"stringUnit":{"state":"translated","value":"외부 전원으로 충전 가능"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外部电源可充电"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"外部電源可充電"}}}},
    "live_ExternalConnected": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"External power connected"}},"ja":{"stringUnit":{"state":"translated","value":"外部電源に接続"}},"de":{"stringUnit":{"state":"translated","value":"Externe Stromversorgung angeschlossen"}},"es":{"stringUnit":{"state":"translated","value":"Alimentación externa conectada"}},"fr":{"stringUnit":{"state":"translated","value":"Alimentation externe connectée"}},"ko":{"stringUnit":{"state":"translated","value":"외부 전원 연결"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外部电源已连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"外部電源已連接"}}}},
    "live_FullyCharged": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Fully charged"}},"ja":{"stringUnit":{"state":"translated","value":"満充電"}},"de":{"stringUnit":{"state":"translated","value":"Vollständig geladen"}},"es":{"stringUnit":{"state":"translated","value":"Carga completa"}},"fr":{"stringUnit":{"state":"translated","value":"Charge complète"}},"ko":{"stringUnit":{"state":"translated","value":"완전 충전"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已充满"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已充滿"}}}},
    "live_IsCharging": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Charging"}},"ja":{"stringUnit":{"state":"translated","value":"充電中"}},"de":{"stringUnit":{"state":"translated","value":"Wird geladen"}},"es":{"stringUnit":{"state":"translated","value":"Cargando"}},"fr":{"stringUnit":{"state":"translated","value":"En charge"}},"ko":{"stringUnit":{"state":"translated","value":"충전 중"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在充电"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在充電"}}}},
    "live_value": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Value"}},"ja":{"stringUnit":{"state":"translated","value":"値"}},"de":{"stringUnit":{"state":"translated","value":"Wert"}},"es":{"stringUnit":{"state":"translated","value":"Valor"}},"fr":{"stringUnit":{"state":"translated","value":"Valeur"}},"ko":{"stringUnit":{"state":"translated","value":"값"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"值"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"值"}}}},
    "live_field": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Field"}},"ja":{"stringUnit":{"state":"translated","value":"項目"}},"de":{"stringUnit":{"state":"translated","value":"Feld"}},"es":{"stringUnit":{"state":"translated","value":"Campo"}},"fr":{"stringUnit":{"state":"translated","value":"Champ"}},"ko":{"stringUnit":{"state":"translated","value":"항목"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"项目"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"項目"}}}},
    "live_details": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show detailed information"}},"ja":{"stringUnit":{"state":"translated","value":"詳細情報を表示"}},"de":{"stringUnit":{"state":"translated","value":"Detailinformationen anzeigen"}},"es":{"stringUnit":{"state":"translated","value":"Mostrar información detallada"}},"fr":{"stringUnit":{"state":"translated","value":"Afficher les informations détaillées"}},"ko":{"stringUnit":{"state":"translated","value":"상세 정보 표시"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示详细信息"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示詳細資訊"}}}},
    "live_details_note": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Internal values, uncertain fields and channel metadata returned by the API. Original names and values are preserved without guessing units or meanings. May include battery identifiers. Displayed in memory only."}},"ja":{"stringUnit":{"state":"translated","value":"内部値・意味が未確定の項目・チャンネル情報です。元の項目名と値を表示し、単位や意味は推測しません。バッテリーの識別情報を含む場合があります。メモリ上でのみ表示します。"}},"de":{"stringUnit":{"state":"translated","value":"Interne Werte, unklare Felder und Kanalmetadaten der API. Originalnamen und Werte bleiben erhalten; Einheiten und Bedeutungen werden nicht angenommen. Kann Akku-Kennungen enthalten. Nur im Arbeitsspeicher."}},"es":{"stringUnit":{"state":"translated","value":"Valores internos, campos inciertos y metadatos de canales de la API. Se conservan nombres y valores sin deducir unidades ni significados. Puede incluir identificadores de batería. Solo en memoria."}},"fr":{"stringUnit":{"state":"translated","value":"Valeurs internes, champs incertains et métadonnées de canaux de l’API. Noms et valeurs conservés sans déduire unités ni sens. Peut inclure des identifiants de batterie. En mémoire uniquement."}},"ko":{"stringUnit":{"state":"translated","value":"API의 내부 값, 의미가 불확실한 항목 및 채널 정보입니다. 단위나 의미를 추측하지 않고 원래 이름과 값을 표시합니다. 배터리 식별 정보가 포함될 수 있습니다. 메모리에만 표시합니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"API返回的内部值、含义未确定的项目和通道信息。保留原始名称和值，不推测单位或含义。可能包含电池标识信息，仅在内存中显示。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"API傳回的內部值、含義未確定的項目和通道資訊。保留原始名稱和值，不推測單位或含義。可能包含電池識別資訊，僅在記憶體中顯示。"}}}},
    "live_details_missing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Full details not received. Update the PC app if necessary."}},"ja":{"stringUnit":{"state":"translated","value":"全項目は未受信です。必要に応じてPCアプリを更新してください。"}},"de":{"stringUnit":{"state":"translated","value":"Vollständige Details nicht empfangen. Bei Bedarf PC-App aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"No se recibieron todos los detalles. Actualiza la app del PC si es necesario."}},"fr":{"stringUnit":{"state":"translated","value":"Détails complets non reçus. Mettez à jour l’app PC si nécessaire."}},"ko":{"stringUnit":{"state":"translated","value":"전체 항목을 받지 못했습니다. 필요한 경우 PC 앱을 업데이트하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未收到全部字段，请根据需要更新电脑应用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未收到全部欄位，請視需要更新電腦應用程式。"}}}},
    "live_details_general": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"General"}},"ja":{"stringUnit":{"state":"translated","value":"基本項目"}},"de":{"stringUnit":{"state":"translated","value":"Allgemein"}},"es":{"stringUnit":{"state":"translated","value":"General"}},"fr":{"stringUnit":{"state":"translated","value":"Général"}},"ko":{"stringUnit":{"state":"translated","value":"기본 항목"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"基本字段"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"基本欄位"}}}},
    "live_true": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"True"}},"ja":{"stringUnit":{"state":"translated","value":"はい"}},"de":{"stringUnit":{"state":"translated","value":"Ja"}},"es":{"stringUnit":{"state":"translated","value":"Sí"}},"fr":{"stringUnit":{"state":"translated","value":"Oui"}},"ko":{"stringUnit":{"state":"translated","value":"예"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"是"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"是"}}}},
    "live_false": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"False"}},"ja":{"stringUnit":{"state":"translated","value":"いいえ"}},"de":{"stringUnit":{"state":"translated","value":"Nein"}},"es":{"stringUnit":{"state":"translated","value":"No"}},"fr":{"stringUnit":{"state":"translated","value":"Non"}},"ko":{"stringUnit":{"state":"translated","value":"아니요"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"否"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"否"}}}},
    "live_network_note": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Receive over the same LAN, or Tailscale with mobile data enabled in PC Link. Availability of fresh acquisition depends on the device connection."}},"ja":{"stringUnit":{"state":"translated","value":"同じLAN、またはPC連携でモバイル通信を許可したTailscale経由で受信できます。新しい値の取得可否は端末への接続状態によります。"}},"de":{"stringUnit":{"state":"translated","value":"Empfang im selben LAN oder über Tailscale bei erlaubten mobilen Daten in PC-Verbindung. Neue Erfassung hängt von der Geräteverbindung ab."}},"es":{"stringUnit":{"state":"translated","value":"Recibe por la misma LAN o Tailscale con datos móviles permitidos en Enlace con PC. La obtención de nuevos valores depende de la conexión al dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"Réception sur le même LAN ou via Tailscale avec les données mobiles autorisées dans Liaison PC. L’acquisition de nouvelles valeurs dépend de la connexion à l’appareil."}},"ko":{"stringUnit":{"state":"translated","value":"같은 LAN 또는 PC 연결에서 모바일 데이터를 허용한 Tailscale로 수신할 수 있습니다. 새 값 수집은 기기 연결 상태에 따라 달라집니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可通过同一局域网接收，或在电脑连接中允许移动数据后通过Tailscale接收。获取新值取决于设备连接状态。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可透過相同區域網路接收，或在電腦連線中允許行動數據後透過Tailscale接收。取得新值取決於裝置連線狀態。"}}}},
    "live_title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Live Battery"}},"ja":{"stringUnit":{"state":"translated","value":"現在のバッテリー"}},"de":{"stringUnit":{"state":"translated","value":"Aktueller Akku"}},"es":{"stringUnit":{"state":"translated","value":"Batería actual"}},"fr":{"stringUnit":{"state":"translated","value":"Batterie actuelle"}},"ko":{"stringUnit":{"state":"translated","value":"현재 배터리"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前电池"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前電池"}}}},
    "live_enable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show Live Battery tab"}},"ja":{"stringUnit":{"state":"translated","value":"現在のバッテリータブを表示"}},"de":{"stringUnit":{"state":"translated","value":"Tab für aktuellen Akku anzeigen"}},"es":{"stringUnit":{"state":"translated","value":"Mostrar pestaña de batería actual"}},"fr":{"stringUnit":{"state":"translated","value":"Afficher l’onglet Batterie actuelle"}},"ko":{"stringUnit":{"state":"translated","value":"현재 배터리 탭 표시"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示当前电池标签页"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示目前電池分頁"}}}},
    "live_enable_note": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Off by default. Requires a paired Mac or Windows PC. Updates while MochiLog is open."}},"ja":{"stringUnit":{"state":"translated","value":"初期設定はオフです。ペアリング済みのMacまたはWindows PCが必要です。MochiLogを開いている間に更新します。"}},"de":{"stringUnit":{"state":"translated","value":"Standardmäßig aus. Erfordert einen gekoppelten Mac oder Windows-PC. Aktualisierung bei geöffneter App."}},"es":{"stringUnit":{"state":"translated","value":"Desactivada por defecto. Requiere un Mac o PC Windows enlazado. Se actualiza con MochiLog abierto."}},"fr":{"stringUnit":{"state":"translated","value":"Désactivé par défaut. Nécessite un Mac ou PC Windows jumelé. Actualisation lorsque MochiLog est ouvert."}},"ko":{"stringUnit":{"state":"translated","value":"기본값은 꺼짐입니다. 페어링된 Mac 또는 Windows PC가 필요합니다. MochiLog가 열려 있는 동안 업데이트됩니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认关闭。需要已配对的Mac或Windows电脑。MochiLog打开时自动更新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預設關閉。需要已配對的Mac或Windows電腦。MochiLog開啟時自動更新。"}}}},
    "live_note": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Current diagnostic estimates, separate from daily logs and Settings battery health. Values are not saved as records. Unchanged values are not resent."}},"ja":{"stringUnit":{"state":"translated","value":"日次ログとは別の診断値です。「設定」のバッテリー状態と異なる場合があります。記録として保存しません。変化のない値は再送しません。"}},"de":{"stringUnit":{"state":"translated","value":"Aktuelle Diagnosewerte, getrennt von täglichen Protokollen. Sie können vom Batteriezustand in Einstellungen abweichen. Keine Speicherung als Einträge; unveränderte Werte werden nicht erneut gesendet."}},"es":{"stringUnit":{"state":"translated","value":"Valores de diagnóstico separados de los registros diarios. Pueden diferir del estado de batería en Ajustes. No se guardan como registros ni se reenvían valores sin cambios."}},"fr":{"stringUnit":{"state":"translated","value":"Valeurs de diagnostic distinctes des journaux quotidiens. Elles peuvent différer de l’état de batterie dans Réglages. Aucune sauvegarde comme enregistrement ; les valeurs inchangées ne sont pas renvoyées."}},"ko":{"stringUnit":{"state":"translated","value":"일일 로그와 별개의 진단값이며 설정의 배터리 상태와 다를 수 있습니다. 기록으로 저장하지 않으며 변경되지 않은 값은 다시 보내지 않습니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这是独立于每日日志的诊断值，可能与设置中的电池健康信息不同。不保存为记录，不重复发送未变化的值。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這是獨立於每日記錄的診斷值，可能與設定中的電池健康資訊不同。不儲存為記錄，不重複傳送未變更的值。"}}}},
    "live_missing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Not acquired"}},"ja":{"stringUnit":{"state":"translated","value":"未取得"}},"de":{"stringUnit":{"state":"translated","value":"Nicht erfasst"}},"es":{"stringUnit":{"state":"translated","value":"Sin obtener"}},"fr":{"stringUnit":{"state":"translated","value":"Non obtenu"}},"ko":{"stringUnit":{"state":"translated","value":"미수집"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未获取"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未取得"}}}},
    "live_last": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Last acquired"}},"ja":{"stringUnit":{"state":"translated","value":"最終取得"}},"de":{"stringUnit":{"state":"translated","value":"Zuletzt erfasst"}},"es":{"stringUnit":{"state":"translated","value":"Última obtención"}},"fr":{"stringUnit":{"state":"translated","value":"Dernière acquisition"}},"ko":{"stringUnit":{"state":"translated","value":"마지막 수집"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最后获取时间"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最後取得時間"}}}},
    "live_receive": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Receive Now"}},"ja":{"stringUnit":{"state":"translated","value":"今すぐ受信"}},"de":{"stringUnit":{"state":"translated","value":"Jetzt empfangen"}},"es":{"stringUnit":{"state":"translated","value":"Recibir ahora"}},"fr":{"stringUnit":{"state":"translated","value":"Recevoir maintenant"}},"ko":{"stringUnit":{"state":"translated","value":"지금 수신"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"立即接收"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"立即接收"}}}},
    "live_send": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Send Now"}},"ja":{"stringUnit":{"state":"translated","value":"今すぐ送信"}},"de":{"stringUnit":{"state":"translated","value":"Jetzt senden"}},"es":{"stringUnit":{"state":"translated","value":"Enviar ahora"}},"fr":{"stringUnit":{"state":"translated","value":"Envoyer maintenant"}},"ko":{"stringUnit":{"state":"translated","value":"지금 전송"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"立即发送"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"立即傳送"}}}},
    "live_request": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Request PC Update"}},"ja":{"stringUnit":{"state":"translated","value":"PCに更新を依頼"}},"de":{"stringUnit":{"state":"translated","value":"PC-Aktualisierung anfordern"}},"es":{"stringUnit":{"state":"translated","value":"Solicitar actualización al PC"}},"fr":{"stringUnit":{"state":"translated","value":"Demander une actualisation au PC"}},"ko":{"stringUnit":{"state":"translated","value":"PC에 업데이트 요청"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求电脑更新"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"要求電腦更新"}}}},
    "live_unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not refresh. Check the device connection; previous values may be shown."}},"ja":{"stringUnit":{"state":"translated","value":"更新できませんでした。端末の接続を確認してください。以前の値が表示される場合があります。"}},"de":{"stringUnit":{"state":"translated","value":"Aktualisierung fehlgeschlagen. Geräteverbindung prüfen; frühere Werte können angezeigt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo actualizar. Comprueba la conexión; pueden mostrarse valores anteriores."}},"fr":{"stringUnit":{"state":"translated","value":"Actualisation impossible. Vérifiez la connexion ; des valeurs précédentes peuvent être affichées."}},"ko":{"stringUnit":{"state":"translated","value":"업데이트할 수 없습니다. 기기 연결을 확인하세요. 이전 값이 표시될 수 있습니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法更新。请检查设备连接，可能显示先前的值。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法更新。請檢查裝置連線，可能顯示先前的值。"}}}},
    "live_pair_first": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair a computer first"}},"ja":{"stringUnit":{"state":"translated","value":"先にPCをペアリング"}},"de":{"stringUnit":{"state":"translated","value":"Zuerst einen Computer koppeln"}},"es":{"stringUnit":{"state":"translated","value":"Enlaza primero un ordenador"}},"fr":{"stringUnit":{"state":"translated","value":"Jumelez d’abord un ordinateur"}},"ko":{"stringUnit":{"state":"translated","value":"먼저 PC를 페어링하세요"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先配对电脑"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請先配對電腦"}}}},
    "live_pair_detail": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the existing PC pairing to view current battery values."}},"ja":{"stringUnit":{"state":"translated","value":"既存のPCペアリングを利用して、現在のバッテリー情報を表示します。"}},"de":{"stringUnit":{"state":"translated","value":"Die bestehende PC-Kopplung zeigt aktuelle Akkuwerte an."}},"es":{"stringUnit":{"state":"translated","value":"Usa el enlace existente con el PC para ver los valores actuales."}},"fr":{"stringUnit":{"state":"translated","value":"Le jumelage PC existant permet de voir les valeurs actuelles."}},"ko":{"stringUnit":{"state":"translated","value":"기존 PC 페어링으로 현재 배터리 정보를 표시합니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过现有电脑配对查看当前电池信息。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"透過現有電腦配對查看目前電池資訊。"}}}},
    "live_pair_open": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open PC Link"}},"ja":{"stringUnit":{"state":"translated","value":"PC連携を開く"}},"de":{"stringUnit":{"state":"translated","value":"PC-Verbindung öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir enlace con PC"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir la liaison PC"}},"ko":{"stringUnit":{"state":"translated","value":"PC 연결 열기"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开电脑连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟電腦連線"}}}},
