    "mt_s_13": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a MochiLog computer pairing QR code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLogのパソコン連携用QRコードではありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist kein QR-Code zur MochiLog-Computer-Kopplung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este no es un código QR de enlace con MochiLog para ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
