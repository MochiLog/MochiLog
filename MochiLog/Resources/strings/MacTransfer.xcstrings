          "stringUnit": {
            "state": "translated",
            "value": "電腦收集記錄"
          }
        }
      }
    },
    "mt_guide_collect_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the device is unlocked, the Mac app collects battery analytics over Wi-Fi and keeps them ready. It can also collect paired Apple Watch logs through the iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のロック解除中に、MacアプリがWi-Fi経由でバッテリー解析ログを集めて保管します。ペアリング済みApple WatchのログもiPhone経由で対象になります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Gerät entsperrt ist, sammelt die Mac-App Batterieanalyseprotokolle über WLAN und hält sie bereit. Protokolle einer gekoppelten Apple Watch kann sie über das iPhone erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el dispositivo desbloqueado, la app del Mac recoge por Wi-Fi los registros de batería y los guarda. También puede recoger los del Apple Watch enlazado a través del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l’appareil est déverrouillé, l’app Mac recueille les journaux de batterie en Wi-Fi et les conserve. Elle peut aussi récupérer ceux de l’Apple Watch jumelée via l’iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 잠금 해제된 동안 Mac 앱이 Wi-Fi로 배터리 분석 로그를 수집해 보관합니다. 페어링된 Apple Watch 로그도 iPhone을 통해 수집할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备解锁期间，Mac App 会通过 Wi-Fi 收集并暂存电池分析日志，也可通过 iPhone 收集已配对 Apple Watch 的日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置解鎖期間，Mac App 會透過 Wi-Fi 收集並暫存電池分析日誌，也可透過 iPhone 收集已配對 Apple Watch 的日誌。"
          }
        }
      }
    },
    "mt_guide_import_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog analyzes and saves"
          }
        },
        "ja": {
