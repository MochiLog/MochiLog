    "mt_084": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To refresh the PC report, open MochiLog on your Mac or Windows PC on the same Wi-Fi or Tailscale, then reopen this screen. Raw analytics logs and pairing secrets are excluded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCの情報を更新するには、同じWi-FiまたはTailscale上でMac／Windowsアプリを開き、この画面を開き直してください。解析ログ本文やペアリングの秘密鍵は含めません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie MochiLog auf dem Mac oder Windows-PC im selben WLAN oder Tailscale und öffnen Sie diese Seite erneut. Rohdaten und Kopplungsgeheimnisse sind ausgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para actualizar el informe, abre MochiLog en el Mac o PC Windows en la misma Wi-Fi o Tailscale y vuelve a esta pantalla. No se incluyen registros sin procesar ni secretos de emparejamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour actualiser le rapport, ouvrez MochiLog sur Mac ou PC Windows via le même Wi-Fi ou Tailscale, puis rouvrez cet écran. Les journaux bruts et les secrets de jumelage sont exclus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 보고서를 갱신하려면 같은 Wi-Fi 또는 Tailscale에서 Mac/Windows 앱을 열고 이 화면을 다시 여세요. 분석 로그 원문과 페어링 비밀키는 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要更新 PC 报告，请在同一 Wi-Fi 或 Tailscale 下打开 Mac 或 Windows 应用，然后重新打开此页面。不包含原始分析日志或配对密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要更新 PC 報告，請在相同 Wi-Fi 或 Tailscale 下開啟 Mac 或 Windows App，然後重新開啟此頁面。不包含原始分析日誌或配對金鑰。"
          }
        }
      }
    },
