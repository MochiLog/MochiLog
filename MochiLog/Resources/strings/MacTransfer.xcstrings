    "mt_019": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR belongs to the selected device. Scan it in MochiLog. The same device ID is restored after reinstalling the iPhone app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRは選択した端末専用です。iPhoneのMochiLogで読み取ってください。再インストール後も同じ個体IDを復元できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR gehört zum ausgewählten Gerät. Scannen Sie es in MochiLog. Die gleiche Geräte-ID wird nach der Neuinstallation der iPhone-App wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este QR pertenece al dispositivo seleccionado. Escanéalo en MochiLog. El mismo ID de dispositivo se restaura después de reinstalar la aplicación para iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR appartient à l'appareil sélectionné. Scannez-le dans MochiLog. Le même identifiant d'appareil est restauré après la réinstallation de l'application iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR은 선택한 장치에 속합니다. MochiLog에서 스캔하세요. iPhone 앱을 다시 설치하면 동일한 장치 ID가 복원됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二维码属于所选设备。在MochiLog中扫描。重新安装iPhone应用程序后，将恢复相同的设备ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此QR碼屬於所選裝置。在MochiLog中掃描。重新安裝iPhone應用程式後，會恢復相同的裝置ID。"
          }
        }
      }
    },
    "mt_020": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR contains a secret key. Do not publish or share it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRには秘密鍵が含まれます。公開・共有しないでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der QR enthält einen geheimen Schlüssel. Veröffentlichen oder teilen Sie es nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El QR contiene una clave secreta. No lo publiques ni lo compartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le QR contient une clé secrète. Ne le publiez pas et ne le partagez pas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR에는 비밀 키가 포함되어 있습니다. 게시하거나 공유하지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码包含一个密钥。请勿发布或分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "QR包含一個密鑰。請勿發佈或分享。"
          }
        }
      }
    },
