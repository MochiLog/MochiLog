    "mt_log_retention_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep connection debug logs for this period. Battery records are unaffected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携の調査用ログを選んだ期間だけ保存します。電池の記録には影響しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungs-Debug-Logs werden für diesen Zeitraum gespeichert. Batteriedaten bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los registros de conexión durante este período. Los datos de batería no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez les journaux de connexion pendant cette durée. Les données de batterie ne sont pas modifiées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 디버그 로그를 선택한 기간 동안 보관합니다. 배터리 기록에는 영향이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接调试日志将保存所选天数。电池记录不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線偵錯記錄將保存所選天數。電池記錄不受影響。"
          }
        }
      }
    },
