    "mt_067": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After reinstalling, pair again with a previously linked computer to recover the same device ID. Locally stored records cannot be recovered after deleting the app. Older records without IDs are not merged automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再インストール後は以前連携したPCと再ペアリングすると同じ個体IDを復元できます。アプリ削除で失われたローカル記録は復元できません。既存のIDなし記録は自動で結合しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Neuinstallation können Sie die Geräte-ID durch erneutes Koppeln mit einem früher verbundenen Computer wiederherstellen. Nur lokal gespeicherte Einträge gehen beim Löschen der App verloren. Ältere Einträge ohne ID werden nicht automatisch zusammengeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras reinstalar, empareja con un ordenador enlazado antes para recuperar el mismo ID. Los registros solo locales no se recuperan al eliminar la app. Los registros antiguos sin ID no se fusionan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après réinstallation, jumelez avec un ordinateur déjà associé pour récupérer le même identifiant. Les données uniquement locales sont perdues après suppression de l’app. Les anciennes données sans identifiant ne fusionnent pas automatiquement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설치 후 이전에 연결한 PC와 다시 페어링하면 같은 기기 ID를 복원할 수 있습니다. 앱 삭제로 사라진 로컬 기록은 복구할 수 없습니다. ID가 없는 이전 기록은 자동 병합하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安装后，与之前连接的电脑重新配对可恢复同一设备 ID。删除应用后丢失的本地记录无法恢复。无 ID 的旧记录不会自动合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安裝後，與先前連接的電腦重新配對可還原相同裝置 ID。刪除 App 後遺失的本機紀錄無法還原。沒有 ID 的舊紀錄不會自動合併。"
          }
        }
      }
    },
    "mt_068": {
      "extractionState": "manual",
