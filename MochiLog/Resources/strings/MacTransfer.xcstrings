    "mt_102": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "MochiLog checks the Mac periodically. A previous response does not mean the devices are continuously connected." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Macとの通信は定期的に確認します。応答履歴があっても、常時接続を意味するものではありません。" } },
        "de": { "stringUnit": { "state": "translated", "value": "MochiLog prüft den Mac regelmäßig. Eine frühere Antwort bedeutet keine dauerhafte Verbindung." } },
        "es": { "stringUnit": { "state": "translated", "value": "MochiLog comprueba el Mac periódicamente. Una respuesta anterior no significa que haya una conexión permanente." } },
        "fr": { "stringUnit": { "state": "translated", "value": "MochiLog vérifie le Mac périodiquement. Une réponse précédente ne signifie pas que la connexion est permanente." } },
        "ko": { "stringUnit": { "state": "translated", "value": "MochiLog는 Mac을 주기적으로 확인합니다. 이전 응답이 계속 연결되어 있음을 뜻하지는 않습니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "MochiLog 会定期检查 Mac。之前收到响应不代表设备始终保持连接。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "MochiLog 會定期檢查 Mac。先前收到回應不代表裝置持續保持連線。" } }
      }
    },
