            "state": "translated",
            "value": "Abra la página de lanzamiento en su Mac e instale la DMG firmada y notariada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la page de publication sur votre Mac et installez le DMG signé et notarié."
          }
