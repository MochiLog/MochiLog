        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre del dispositivo:\nIdentificador del modelo (ejemplo: iPhone19,2):\nModelo de SIM (iPhone 17 o posterior, excepto Air/Duo):\nCapacidad que muestra actualmente MochiLog:\nCapacidad correcta:\nURL de la fuente de información (opcional):\n\nDetalles adicionales:"
