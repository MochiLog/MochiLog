        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 동안의 충전 상태(SoC) 범위입니다. 0%에서 100%까지 자주 충방전하면 마모가 빨라질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当天的电量范围（SoC）。频繁从0%充至100%可能加速电池损耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當天的電量範圍（SoC）。頻繁從0%充至100%可能加速電池耗損。"
          }
        }
      }
    },
    "hint_cycle_count" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl vollständiger Lade- und Entladezyklen (0→100 %). Mehr Zyklen bedeuten meist stärkeren Verschleiß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of times the battery has gone through a complete charge cycle (0→100%). Higher counts generally indicate more wear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de ciclos completos de carga y descarga (0→100%). Más ciclos suelen indicar mayor desgaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de cycles complets de charge et décharge (0→100 %). Un nombre élevé indique généralement plus d’usure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーが完全な充放電サイクル（0→100%）を繰り返した回数です。回数が多いほど劣化が進んでいる傾向があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 완전한 충방전 사이클(0→100%)을 거친 횟수입니다. 횟수가 많을수록 대체로 마모가 큽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池完成完整充放电循环（0→100%）的次数。次数越多，通常损耗越大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電池完成完整充放電循環（0→100%）的次數。次數越多，通常耗損越大。"
          }
        }
      }
    },
    "hint_deflator" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrekturfaktor, den Apple zur Berechnung der Nennkapazität aus der Rohkapazität anwendet. Ein höherer Wert bedeutet eine stärkere Anpassung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A correction factor Apple applies to the raw capacity to calculate the nominal capacity. A higher deflator means Apple is adjusting the value more significantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Factor de corrección que Apple aplica a la capacidad medida para obtener la nominal. Un valor mayor indica un ajuste mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facteur de correction appliqué par Apple à la capacité brute pour obtenir la capacité nominale. Une valeur élevée indique une correction plus importante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleが実測容量から公称容量を算出する際に適用する補正係数です。値が大きいほど、Appleが値を大きく調整していることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 실측 용량에서 공칭 용량을 계산할 때 적용하는 보정 계수입니다. 클수록 조정 폭이 큽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple从实测容量计算标称容量时使用的修正系数。数值越大，调整幅度越大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple從實測容量計算標稱容量時使用的修正係數。數值越大，調整幅度越大。"
          }
        }
      }
    },
    "hint_design_capacity" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriekapazität bei der Herstellung (mAh). Sie dient als 100-%-Referenz für die Zustandsberechnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original battery capacity when the device was manufactured (mAh). This is used as the 100% baseline for health calculations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capacidad de la batería de fábrica (mAh). Se usa como referencia del 100% para calcular su estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capacité de la batterie à la fabrication (mAh), utilisée comme référence de 100 % pour le calcul de son état."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "製造時のバッテリー容量（mAh）です。バッテリー健康状態を100%とした際の基準値として使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제조 당시의 배터리 용량(mAh)으로, 배터리 상태 100%의 기준값입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备出厂时的电池容量（mAh），用作电池健康度100%的计算基准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置出廠時的電池容量（mAh），用作電池健康度100%的計算基準。"
          }
        }
      }
    },
    "hint_diagnostic_result" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzung anhand des berechneten Zustands.\n\n✅ Normal: ab 90 %\nℹ️ Leicht verschlissen: 80–90 %\n⚠️ Austausch empfohlen: unter 80 %\n\nKeine offizielle Bewertung von Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An estimated condition based on the calculated health percentage.\n\n✅ Normal: 90% or above\nℹ️ Slightly Degraded: 80–90%\n⚠️ Replace Recommended: below 80%\n\nThese are estimates, not Apple's official assessment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación basada en el porcentaje calculado.\n\n✅ Normal: 90% o más\nℹ️ Leve desgaste: 80–90%\n⚠️ Sustitución recomendada: menos del 80%\n\nNo es una evaluación oficial de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation basée sur le pourcentage calculé.\n\n✅ Normal : 90 % ou plus\nℹ️ Légère usure : 80–90 %\n⚠️ Remplacement conseillé : moins de 80 %\n\nCe n’est pas une évaluation officielle d’Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算されたバッテリー健康状態のパーセントに基づく推定的な診断です。\n\n✅ 正常: 90%以上\nℹ️ やや劣化: 80〜90%\n⚠️ 交換推奨: 80%未満\n\nApple公式の評価ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계산된 배터리 상태를 바탕으로 한 추정입니다.\n\n✅ 정상: 90% 이상\nℹ️ 약간 저하: 80–90%\n⚠️ 교체 권장: 80% 미만\n\nApple의 공식 평가가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据计算出的健康度进行估算。\n\n✅ 正常：90%及以上\nℹ️ 轻度损耗：80–90%\n⚠️ 建议更换：低于80%\n\n这不是Apple官方评估。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據計算出的健康度進行估算。\n\n✅ 正常：90%以上\nℹ️ 輕度耗損：80–90%\n⚠️ 建議更換：低於80%\n\n這不是Apple官方評估。"
          }
        }
      }
    },
