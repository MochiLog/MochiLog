    "open_app_after_share_import_description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Ergebnisse nach dem Import. Wenn deaktiviert, öffnet sich bei vollständigem Erfolg die Analyse. Fehler oder erforderliche Prüfungen werden weiterhin angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show results after importing. When disabled, return to Analytics if all items succeed; errors and items needing review still show results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los resultados al terminar. Si se desactiva, vuelve al análisis cuando todo se importa correctamente; los errores o elementos que requieren revisión se siguen mostrando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les résultats à la fin. Si désactivé, revient à l’analyse lorsque tout réussit ; les erreurs ou éléments à vérifier restent affichés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込み後に結果を表示します。オフの場合、すべて成功すると解析画面に戻ります。エラーや確認が必要な項目がある場合は結果を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 가져오기 결과를 표시합니다. 끄면 모두 성공했을 때 분석 화면으로 돌아갑니다. 오류가 있거나 확인이 필요하면 결과가 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，导入完成时显示结果。关闭后，全部成功时返回分析页面；发生错误或需要确认时仍显示结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，匯入完成時顯示結果。關閉後，全部成功時返回分析頁面；發生錯誤或需要確認時仍顯示結果。"
          }
        }
      }
    },
