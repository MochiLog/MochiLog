{
  "sourceLanguage": "ja",
  "strings": {
    "exact_duplicates_title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複記録の整理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Duplicate Records"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelte Einträge prüfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar registros duplicados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner les doublons"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 기록 정리"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查重复记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查重複記錄"
          }
        }
      }
    },
    "exact_duplicates_explanation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が完全に一致する記録だけを表示します。日時・機種・個体ID・測定値などが異なる記録は対象外です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only records with identical log details are shown. Different dates, devices, physical-device IDs, or measurements are excluded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Einträge mit identischen Protokolldaten werden angezeigt. Abweichende Daten, Geräte-IDs oder Messwerte sind ausgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran registros con datos idénticos. Se excluyen fechas, dispositivos, ID físicos o mediciones diferentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les relevés aux données identiques sont affichés. Les dates, appareils, identifiants ou mesures différents sont exclus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 내용이 완전히 같은 기록만 표시합니다. 날짜, 기기 ID 또는 측정값이 다르면 제외됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示日志内容完全相同的记录。日期、设备标识或测量值不同的记录不会列出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示日誌內容完全相同的記錄。日期、裝置識別碼或測量值不同的記錄不會列出。"
          }
        }
      }
    },
    "exact_duplicates_none": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全一致の重複はありません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No exact duplicates found"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine exakten Duplikate gefunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay duplicados exactos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun doublon exact"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전히 중복된 기록이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有完全相同的重复记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有完全相同的重複記錄"
          }
        }
      }
    },
