    "exact_duplicates_remove_selected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "余分な%d件を削除"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %d extra records"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d zusätzliche Einträge entfernen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar %d registros adicionales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %d relevés supplémentaires"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 기록 %d개 삭제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %d 条额外记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 %d 筆額外記錄"
          }
        }
      }
    },
    "exact_duplicates_recheck": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除直前に同期後の記録を再確認し、各組を必ず1件残します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records are checked again immediately before deletion. One copy is always kept in each group."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Löschen wird erneut geprüft. Pro Gruppe bleibt immer ein Eintrag erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuelve a comprobar antes de eliminar. Siempre se conserva una copia por grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle vérification a lieu avant la suppression. Une copie est toujours conservée par groupe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 직전에 다시 확인하며 각 그룹에서 한 기록은 항상 보존합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除前会再次检查，每组始终保留一条记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除前會再次檢查，每組一律保留一筆記錄。"
          }
        }
      }
    },
    "exact_duplicates_save_backup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除前のバックアップを保存"
          }
        },
        "en": {
