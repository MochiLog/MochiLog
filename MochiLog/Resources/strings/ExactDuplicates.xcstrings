            "state": "translated",
            "value": "Enregistrer la sauvegarde"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 전 백업 저장"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存清理前备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存清理前備份"
          }
        }
      }
    },
    "exact_duplicates_backup_footer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理前の全記録をYAMLに保存しました。必要なら「ファイル」に書き出してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All records were saved to YAML before cleanup. Export the backup to Files if needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge wurden vor der Bereinigung als YAML gesichert. Bei Bedarf in Dateien exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los registros se guardaron como YAML antes de limpiar. Exporte la copia a Archivos si lo desea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les relevés ont été sauvegardés en YAML avant le nettoyage. Exportez-les dans Fichiers si nécessaire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 전 모든 기록을 YAML로 저장했습니다. 필요하면 파일 앱으로 내보내세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理前已将所有记录保存为 YAML。需要时可导出到“文件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理前已將所有記錄儲存為 YAML。需要時可匯出至「檔案」。"
          }
        }
      }
    },
    "exact_duplicates_confirm_title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した重複を整理しますか？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove selected duplicates?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Duplikate entfernen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar los duplicados seleccionados?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les doublons sélectionnés ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 중복 기록을 정리할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所选重复记录？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除所選重複記錄？"
          }
        }
      }
    },
    "exact_duplicates_confirm_message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d件の余分な記録を削除します。先に全記録のバックアップを作成し、各組は1件残します。iCloud同期中のほかの端末にも削除が反映されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d extra records will be removed after a full backup is created. One copy per group remains. The deletion syncs to other devices using iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d zusätzliche Einträge werden nach einer vollständigen Sicherung entfernt. Pro Gruppe bleibt eine Kopie. Die Löschung wird über iCloud synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %d registros adicionales tras crear una copia completa. Quedará uno por grupo. La eliminación se sincroniza mediante iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d relevés supplémentaires seront supprimés après une sauvegarde complète. Un par groupe restera. La suppression sera synchronisée via iCloud."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 백업을 만든 뒤 중복 기록 %d개를 삭제합니다. 각 그룹에 하나는 남으며 iCloud를 통해 다른 기기에도 반영됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建完整备份后将删除 %d 条额外记录。每组保留一条，删除会通过 iCloud 同步到其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立完整備份後將刪除 %d 筆額外記錄。每組保留一筆，刪除會透過 iCloud 同步到其他裝置。"
          }
        }
      }
    },
