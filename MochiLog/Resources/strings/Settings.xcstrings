    "profile_save_help" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved values are used for future imports. Update existing log names and design capacities using the action below. Displayed SoC information updates after saving."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存後は今後のログ取り込みに使用します。既存ログの機種名・設計容量は下の操作で反映できます。SoCの説明表示は保存後に更新されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存后用于今后的导入。可用下方操作更新现有日志的名称和设计容量。SoC 信息在保存后更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存後用於之後的匯入。可用下方操作更新現有日誌的名稱及設計容量。SoC 資訊在儲存後更新。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 값은 이후 가져오기에 사용됩니다. 아래 작업으로 기존 로그의 이름과 설계 용량을 업데이트할 수 있습니다. SoC 정보는 저장 후 업데이트됩니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores guardados se usarán en futuras importaciones. Actualice los nombres y capacidades de los registros con la acción siguiente. La información del SoC cambia al guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs enregistrées servent aux futures importations. L’action ci-dessous met à jour les noms et capacités des journaux existants. Les informations SoC sont actualisées à l’enregistrement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Werte gelten für künftige Importe. Vorhandene Lognamen und Auslegungskapazitäten können unten aktualisiert werden. SoC-Informationen werden nach dem Speichern aktualisiert."
          }
        }
      }
