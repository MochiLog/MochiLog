        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 같은 날짜와 기기의 로그를 여러 개 기록할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，同一设备在同一天可记录多份日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，同一裝置在同一天可記錄多份日誌。"
          }
        }
      }
    },
