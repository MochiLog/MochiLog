    "rendering_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduced effects limit shadows, blur and extra chart compositing. Automatic switches in Low Power Mode, high temperatures or on devices with 4 GB of memory or less."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽量では影・ぼかしとグラフの追加合成を抑えます。自動は省電力・高温・メモリ4GB以下で切り替えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻量模式减少阴影、模糊及额外的图表合成。自动模式会在低电量模式、高温或内存不超过 4 GB 时切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕量模式減少陰影、模糊及額外的圖表合成。自動模式會在低耗電模式、高溫或記憶體不超過 4 GB 時切換。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "효과 축소는 그림자, 흐림과 추가 차트 합성을 줄입니다. 자동은 저전력 모드, 고온 또는 메모리 4 GB 이하에서 전환됩니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce sombras, desenfoque y composición adicional de gráficos. Automático cambia con bajo consumo, temperatura alta o memoria de 4 GB o menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit les ombres, le flou et la composition supplémentaire des graphiques. Le mode automatique bascule en économie d’énergie, à température élevée ou avec 4 Go de mémoire ou moins."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduziert Schatten, Unschärfe und zusätzliche Diagrammeffekte. Automatisch schaltet bei Stromsparmodus, hoher Temperatur oder höchstens 4 GB Arbeitsspeicher um."
          }
        }
      }
    },
