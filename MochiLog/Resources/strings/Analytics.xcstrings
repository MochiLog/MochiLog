    "stat_health_change_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初と最新の最大容量（％）の差です。測定値は変動することがあります。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difference between the first and latest battery health percentages. Measurements can fluctuate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最早与最新电池健康百分比之差。测量值可能波动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最早與最新電池健康百分比之差。測量值可能波動。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 기록과 최신 기록의 배터리 성능 백분율 차이입니다. 측정값은 변동할 수 있습니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferencia entre los porcentajes inicial y final de salud de batería. Las mediciones pueden fluctuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écart entre les pourcentages initial et final de santé de la batterie. Les mesures peuvent fluctuer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Differenz zwischen erstem und letztem Batteriezustand in Prozent. Messwerte können schwanken."
          }
        }
      }
    },
