          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 속 화면으로 계속 시청"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用画中画继续观看"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用子母畫面繼續觀看"
          }
        }
      }
    },
    "pip_instruction_detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video läuft in einem schwebenden Fenster weiter.\nAktiviere Einstellungen > Allgemein > Bild-in-Bild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The video will continue playing in a floating window.\n*Please ensure Picture in Picture is enabled in Settings > General > Picture in Picture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo seguirá en una ventana flotante.\nActiva la función en Ajustes > General > Imagen dentro de imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo continuera dans une fenêtre flottante.\nActivez Réglages > Général > Image dans l’image."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画はフローティングウィンドウで再生され続けます。\n※iPhone/iPadの設定 > 一般 > ピクチャ・イン・ピクチャ をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상은 작은 창에서 계속 재생됩니다.\n설정 > 일반 > 화면 속 화면을 켜주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频将继续在浮动窗口中播放。\n请在“设置”>“通用”>“画中画”中启用此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片會繼續在浮動視窗播放。\n請在「設定」>「一般」>「子母畫面」中啟用此功能。"
          }
        }
      }
    },
    "pip_note" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgrund von iOS-Problemen erscheint Bild-in-Bild manchmal nicht. Ein Neustart der App oder des Geräts kann helfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: Due to iOS limitations, PIP may occasionally fail to display. Restarting the app or device may resolve this issue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por limitaciones de iOS, la ventana flotante puede no aparecer. Reiniciar la app o el dispositivo puede resolverlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image dans l’image peut parfois ne pas apparaître à cause d’iOS. Redémarrer l’app ou l’appareil peut aider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※iOSの不具合により、PIPが稀に表示されない場合があります。\nアプリや端末の再起動で直る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 문제로 화면 속 화면이 나타나지 않을 수 있습니다. 앱이나 기기를 다시 실행해 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于iOS问题，画中画有时可能不显示。重新启动应用或设备可能有帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於iOS問題，子母畫面有時可能無法顯示。重新啟動App或裝置可能有幫助。"
          }
        }
      }
    },
