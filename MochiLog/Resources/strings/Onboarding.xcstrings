    "pip_instruction" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Bild-in-Bild weiter ansehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Picture-in-Picture to keep watching"
