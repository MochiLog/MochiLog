    "discord_announcement_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Teilnahme ist freiwillig. Den Link findest du jederzeit in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participation is optional. You can always find the link in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La participación es opcional. Encontrarás el enlace en Ajustes cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La participation est facultative. Le lien reste disponible dans les réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加は任意です。設定からいつでもアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참여는 선택 사항입니다. 설정에서 언제든지 링크를 찾을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否加入由您决定。您随时可以在设置中找到链接。"
