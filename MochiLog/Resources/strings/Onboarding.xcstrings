    "discord_announcement_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine Ideen und Fehlerberichte direkt mit uns"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your ideas and bug reports with us directly"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tus ideas e informes de errores con nosotros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez directement vos idées et signalements de bugs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご要望や不具合などを直接共有できる場所を用意しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이디어와 오류를 직접 공유해주세요"
