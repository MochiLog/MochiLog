diff --git a/src/backend/mochilog.rs b/src/backend/mochilog.rs
new file mode 100644
index 0000000..57e9fbb
--- /dev/null
+++ b/src/backend/mochilog.rs
@@ -0,0 +1,90 @@
+use std::io::Cursor;
+
+/// Preserve all pairing fields and add the authenticated device's identity.
+/// This metadata is for MochiLog only; other installation targets are unchanged.
+pub fn with_identity(bytes: &[u8], udid: &str) -> Result<Vec<u8>, String> {
+    if bytes.is_empty()
+        || bytes.len() > 65536
+        || !(16..=64).contains(&udid.len())
+        || !udid.bytes().all(|c| c.is_ascii_hexdigit() || c == b'-')
+    {
+        return Err("Invalid MochiLog pairing file or device identity".into());
+    }
+    let mut value = plist::Value::from_reader(Cursor::new(bytes))
+        .map_err(|_| "Invalid MochiLog pairing plist")?;
+    let dictionary = value
+        .as_dictionary_mut()
+        .ok_or("MochiLog pairing must be a dictionary")?;
+    for key in ["UDID", "udid"] {
+        if let Some(existing) = dictionary.get(key) {
+            if existing.as_string() != Some(udid) {
+                return Err("MochiLog pairing file belongs to a different device".into());
+            }
+        }
+    }
+    dictionary.insert("UDID".into(), udid.into());
+    let mut result = Vec::new();
+    value
+        .to_writer_xml(&mut result)
+        .map_err(|_| "Cannot encode MochiLog pairing file")?;
+    if result.len() > 65536 {
+        return Err("MochiLog pairing file is too large".into());
+    }
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const UDID: &str = "00008100-0000000000000001";
+
+    fn bytes(dictionary: plist::Dictionary) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        plist::Value::Dictionary(dictionary)
+            .to_writer_binary(&mut bytes)
+            .unwrap();
+        bytes
+    }
+
+    #[test]
+    fn remote_metadata_and_keys_are_preserved() {
+        let mut source = plist::Dictionary::new();
+        source.insert("identifier".into(), "test".into());
+        source.insert("private_key".into(), plist::Value::Data(vec![1; 32]));
+        source.insert("alt_irk".into(), plist::Value::Data(vec![2; 16]));
+        source.insert("future_metadata".into(), "opaque".into());
+        let installed = with_identity(&bytes(source.clone()), UDID).unwrap();
+        let result = plist::Value::from_reader(Cursor::new(installed)).unwrap();
+        let result = result.as_dictionary().unwrap();
+        assert_eq!(
+            result.get("UDID").and_then(plist::Value::as_string),
+            Some(UDID)
+        );
+        for (key, value) in source {
+            assert_eq!(result.get(&key), Some(&value));
+        }
+    }
+
+    #[test]
+    fn mismatched_identity_is_never_rebound() {
+        for key in ["UDID", "udid"] {
+            let mut source = plist::Dictionary::new();
+            source.insert(key.into(), "00008100-0000000000000002".into());
+            assert!(with_identity(&bytes(source), UDID).is_err());
+        }
+    }
+
+    #[test]
+    fn matching_identity_survives() {
+        let mut source = plist::Dictionary::new();
+        source.insert("UDID".into(), UDID.into());
+        assert!(with_identity(&bytes(source), UDID).is_ok());
+    }
+
+    #[test]
+    fn malformed_and_oversized_inputs_fail_without_credentials_in_errors() {
+        assert!(with_identity(b"not a plist", UDID).is_err());
+        assert!(with_identity(&vec![0; 65537], UDID).is_err());
+        assert!(with_identity(&bytes(plist::Dictionary::new()), "not-an-identity").is_err());
+    }
+}
